{
  "openapi": "3.0.3",
  "info": {"title": "Movies API", "version": "1.0.0"},
  "paths": {
    "/load-movies": {
      "get": {
        "summary": "Загрузить фильмы со стенда в диапазоне [from; to]",
        "parameters": [
          {"name": "from", "in": "query", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"name": "to", "in": "query", "required": true, "schema": {"type": "integer", "minimum": 1}}
        ],
        "responses": {
          "200": {"description": "Фильмы и частичные ошибки", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoadMoviesResponse"}}}},
          "400": {"description": "Некорректные from/to", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "502": {"description": "Ошибка стенда", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "504": {"description": "Стенд не ответил вовремя", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/last-movie": {
      "get": {
        "summary": "Найти последний доступный фильм на стенде",
        "responses": {
          "200": {"description": "Последний фильм", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Movie"}}}},
          "404": {"description": "На стенде нет фильмов", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "502": {"description": "Ошибка стенда", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "504": {"description": "Стенд не ответил вовремя", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Movie": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "title": {"type": "string"},
          "img": {"type": "string"}
        }
      },
      "LoadError": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "message": {"type": "string"}
        }
      },
      "LoadMoviesResponse": {
        "type": "object",
        "properties": {
          "movies": {"type": "array", "items": {"$ref": "#/components/schemas/Movie"}},
          "errors": {"type": "array", "items": {"$ref": "#/components/schemas/LoadError"}}
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {"type": "string"},
              "message": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
